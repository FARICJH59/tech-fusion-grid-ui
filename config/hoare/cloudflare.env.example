# Public HOARE edge hostname.
HOARE_PUBLIC_DOMAIN=hoare.ai

# Cloudflare Zone ID for hoare.ai. Supply at deployment time; do not guess it.
CLOUDFLARE_ZONE_ID=<CLOUDFLARE_ZONE_ID>

# Cloudflare credentials must be supplied through the runtime credential provider.
# Never commit a real API token here.
# Required Cloudflare permission for DNS record mutation: Zone DNS Write.
